@page "/online-enquiry"
@model manaslearning.UI.Pages.OnlineEnquiryModel
@{
    Layout = "_Layout_Main";
    ViewBag.Title = "Online Enquiry Form - Help Your Child With Special Education Needs";
    ViewBag.MetaDescription = "Feel free to connect with us for any query or support on choosing your assessment. Please fill the form & our team will contact you soon for special education needs!";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("09/26/2020", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}

<!-- Hero Banner -->
<div class="hero-banner-two">
    <div class="container">
        <div class="row">
            <div class="col-sm-8 pt-180 pb-80 md-pt-30 md-pb-60">
                <h2 class="hero-heading font-recoleta pb-20 ">Online Enquiry</h2>
                <p class="">Unleash the hidden ‘Extraordinary’ in your child and inspire a love for learning </p>
            </div>
            <div class="col-sm-4 pb-40 pt-10 "><img src="~/main/images/assets/enquiry-img.png" alt=""></div>
        </div>
    </div>
</div>
<!-- end hero-banner-one -->
<!-- ML Body Section -->
<div class="contact-section-two light-bg pt-20 pb-20 lg-pt-10 lg-pb-100">
    <div class="bg-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-xl-8 col-lg-8 me-auto pt-60">
                    <div class="contact-meta-one">
                        <p>The fundamentals of learning and talent among children start developing early on. Have you identified the potential of your child yet?</p>
                        <p>We can assist you to recognize the strengths and weaknesses in your child and suggest courses, assessments, counseling, and classes to encourage better learning behaviors. We aim to target different ways of comprehension and provide customized guidance to shape children into who they’re destined to be.</p>
                        <p>Our trained experts are here to extend services to children as well as parents for a better understanding of the journey towards knowledge. We have a variety of classes, services, assessments, and expert therapies curated to match your child’s needs.</p>
                        <p>Delve into the myriad of dedicated learning sessions that encourage all aspects of creative development.</p>
                        <p>Explore the capabilities of your child’s skills and comprehension by filling out our form. </p>
                        <h4 class="title pt-40">Services Offered:</h4>
                        <div class="accordion accordion-style-four pt-20" id="accordionOne">
                            <div class="accordion-item">
                                <div class="accordion-header" id="headingOne">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                        Therapy
                                    </button>
                                </div>
                                <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionOne">
                                    <div class="accordion-body">
                                        <ul class="ui-list-item-one style-none">
                                            <li>Behavioral therapy</li>
                                            <li>Occupational therapy</li>
                                            <li>Vocational therapy</li>
                                            <li>Gestalt therapy</li>
                                            <li>ADA therapy</li>
                                            <li>ABC therapy</li>
                                            <li>CBT (Cognitive behavioral therapy)</li>
                                            <li>Speech therapy</li>
                                            <li>Clay therapy</li>
                                            <li>Art therapy</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <div class="accordion-header" id="headingTwo">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        Classes
                                    </button>
                                </div>
                                <div id="collapseTwo" class="accordion-collapse collapse "
                                     aria-labelledby="headingTwo" data-bs-parent="#accordionOne">
                                    <div class="accordion-body">
                                        <ul class="ui-list-item-one style-none">
                                            <li>Phonics</li>
                                            <li>Language</li>
                                            <li>Spelling</li>
                                            <li>Reading</li>
                                            <li>Writing</li>
                                            <li>Math</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <div class="accordion-header" id="headingThree">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                        Tests and Assessments
                                    </button>
                                </div>
                                <div id="collapseThree" class="accordion-collapse collapse"
                                     aria-labelledby="headingThree" data-bs-parent="#accordionOne">
                                    <div class="accordion-body">
                                        <ul class="ui-list-item-one style-none">
                                            <li>Paid Assessments</li>
                                            <li>Free Assessments</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <div class="accordion-header" id="headingFour">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapseFour"
                                            aria-expanded="false" aria-controls="collapseFour">
                                        Consultation
                                    </button>
                                </div>
                                <div id="collapseFour" class="accordion-collapse collapse"
                                     aria-labelledby="headingFour" data-bs-parent="#accordionOne">
                                    <div class="accordion-body">
                                        <ul class="ui-list-item-one style-none">
                                            <li>Chat consultation</li>
                                            <li>Audio consultation</li>
                                            <li>Video consultation</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <div class="accordion-header" id="headingFive">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapseFive"
                                            aria-expanded="false" aria-controls="collapseFour">
                                        Counseling
                                    </button>
                                </div>
                                <div id="collapseFive" class="accordion-collapse collapse"
                                     aria-labelledby="headingFive" data-bs-parent="#accordionOne">
                                    <div class="accordion-body">
                                        <ul class="ui-list-item-one style-none">
                                            <li>Parent counseling</li>
                                            <li>Child counseling</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <p class="pt-40">Contact us today to understand your child through their language of learning.</p>
                    </div>
                </div>
                <div class="col-lg-4 pt-40">
                    <div class="form-style-one with-border md-mt-40 pt-40">
                        <!-- Form Start -->
                        <form id="online-enquiry-form" name="onlineenquiryform" method="post" action="/api/onlineenquiry" novalidate>
                            <div class="row controls">
                                <div class="col-12">
                                    <div class="input-group-meta form-group mb-25">
                                        <input class="form-control" type="text" id="txtName" name="name" placeholder="Name" maxlength="200" />
                                        <div class="invalid-feedback">Name is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group-meta form-group mb-25">
                                        <input class="form-control" type="email" id="txtEmail" name="email" placeholder="Enter your email" maxlength="200" />
                                        <div class="invalid-feedback">Valid email is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group-meta form-group mb-25">
                                        <input class="form-control" type="text" id="txtPhoneNumber" name="name" placeholder="Phone Number" maxlength="50" />
                                        <div class="invalid-feedback">Phone number is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group-meta form-group mb-25">
                                        <input class="form-control" type="text" id="txtCity" name="name" placeholder="City" maxlength="100" />
                                        <div class="invalid-feedback">City is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group-meta form-group mb-25">
                                        <input class="form-control" type="number" id="txtAge" name="name" placeholder="Child Age" min="3" max="70" />
                                        <div class="invalid-feedback">Child age required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <h5>Service Required</h5>
                                    <div class="agreement-checkbox">
                                        <div class="d-inline-row">
                                            <input type="checkbox" id="chkService1" value="Therapy">
                                            <label for="chkService1">Therapy</label>
                                        </div>
                                    </div>
                                    <div class="agreement-checkbox">
                                        <div class="d-inline-row">
                                            <input type="checkbox" id="chkService2" value="Classes">
                                            <label for="chkService2">Classes</label>
                                        </div>
                                    </div>
                                    <div class="agreement-checkbox">
                                        <div class="d-inline-row">
                                            <input type="checkbox" id="chkService3" value="Assessments">
                                            <label for="chkService3">Assessments</label>
                                        </div>
                                    </div>
                                    <div class="agreement-checkbox">
                                        <div class="d-inline-row">
                                            <input type="checkbox" id="chkService4" value="Consultation">
                                            <label for="chkService4">Consultation</label>
                                        </div>
                                    </div>
                                    <div class="agreement-checkbox">
                                        <div class="d-inline-row">
                                            <input type="checkbox" id="chkService5" values="Counselling">
                                            <label for="chkService5">Counselling</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group-meta form-group mt-35 mb-35">
                                        <textarea class="form-control" id="txtMessage" name="message" placeholder="Leave a comment" maxlength="1000"></textarea>
                                        <div class="invalid-feedback"></div>
                                    </div>
                                </div>
                                <div class="col-12" id="btnSendMessage">
                                    <button class="btn-send-message theme-btn-one xs w-100" type="button">Submit</button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <div class="alert alert-success contact-msg" style="display: none" role="alert">
                                        Your message was sent successfully. Our team will contact you shortly.
                                    </div>
                                    <div class="alert alert-danger contact-msg" style="display: none" role="alert">
                                        An error occured while sending your enquiry. Plese try again.
                                    </div>
                                </div>
                            </div>
                            @Html.AntiForgeryToken()
                        </form>
                        <!-- Form End -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var siteKey = '@Model.ReCaptchaSiteKey';
</script>
<!-- reCAPTCHA -->
<script src="https://www.google.com/recaptcha/api.js?render=@Model.ReCaptchaSiteKey"></script>
<script src="~/js/online-enquiry.js"></script>