@page "/consult"
@model manaslearning.UI.Pages.ConsultModel
@{
    Layout = "_LayoutForPages";
    ViewBag.Title = "Consult";
    ViewBag.MetaDescription = "Consult";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("09/26/2020", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}


<!-- maintenance mode -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 font-weight-bold text-grad">Something exciting is coming your way!</h1>
                @*<p>A Full package Digital Creative Agency Specializing in: Video Production, Web Design, Branding, Brand Strategy, Content Marketing and Aerial Cinematography. We are an insight and behavior driven creative marketing agency.</p>*@
            </div>
        </div>
    </div>
</section>