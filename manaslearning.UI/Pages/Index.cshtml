@page ""
@model IndexModel
@{
    Layout = "_Layout_Main";
    ViewBag.Title = "Child Learning Problems | Remedial Education & Assessments for Children | MANAS Learning";
    ViewBag.MetaDescription = "MANAS Learning offers comprehensive remedial education for children with learning problems (Reading, Writing, Math Skills, etc.). Enroll in Assessment tests and assist the special children effectively!";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("06/22/2022", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}

