@page "/child-academic-problems/understanding-your-childs-trouble-with-math"
@model manaslearning.UI.Pages.ChildAcademicProblems.MathsModel
@{
    Layout = "~/Pages/Shared/_LayoutForPages.cshtml";
    ViewBag.Title = "Understanding Your Child's Trouble With Math";
    ViewBag.MetaDescription = "Why is Math so difficult for some kids? Is it OK for your child to be “bad at math”? Get an understanding of math problems in children.";
    ViewBag.MetaKeywords = "child struggling with math, trouble solving math word problems, understanding of math difficulties in children, mathematics learning disabilities, math learning disabilities, dyscalculia, types of math learning problems";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("10/12/2020", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}

<article>
    <!-- Banner innerpage -->
    <div class="innerpage-banner center bg-overlay-dark-7 maths-page-banner-background-image">
        <div class="container">
            <div class="row all-text-white">
                <div class="col-md-12 text-left">
                    <div class="hero-wrapper">
                        <div class="hero-container pt-4 pb-3">
                            <div class="hero-button">
                                <a class="btn btn-sm btn-white btn-round-home" href="/child-academic-problems"><i class="fa fa-angle-left"></i>Child Academic Problems</a>
                            </div>
                            <div class="hero-content">
                                <header>
                                    <h1 class="innerpage-title">Child Struggling with Math</h1>
                                </header>
                                @*<h6 class="subtitle">We transform your perception into an excellent website</h6>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container py-3 py-md-4">
        <div class="row">
            <div class="col-12">
                <div class="divider"></div>
            </div>
        </div>
    </div>
    <!-- Topic Description -->
    <section class="pt-0 pb-3 text-dark">
        <div class="container article">
            <div class="row">
                <!-- accordion gradient -->
                <div class="col-md-12">
                    <main>
                        <div>
                            <h2 class="text-primary display-8">Understanding Your Child's Trouble With Math</h2>
                            <p class="fs-1">
                                Maths is a basic necessity of life. Children who have a problem with math have difficulty understanding abstract concepts, gets confused in the number order, signs like +, -, x, etc. Some might have a problem with the time and money concept also. Children can get confused or overwhelmed with advanced math concepts like trigonometry, calculus, or sometimes algebra. That’s not a difficulty or a problem.
                            </p>
                            <h2 class="text-primary display-8">Signs</h2>
                            <ul class="mb-3" type="disc">
                                <li>Gets less marks in math, makes silly mistakes, gets confused with numbers.</li>
                                <li>Problem in recognizing numbers. Confuses in counting objects.</li>
                                <li>Lacks basic addition, subtraction, multiplication, division concept. Any of these.</li>
                                <li>Does not understand place values. Can't do mental maths needs to count on finger or other methods.</li>
                                <li>Poor in fractions, decimals.</li>
                            </ul>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </section>
</article>
<!-- Other topics -->
<aside>
    @await Component.InvokeAsync("ChildAcademicProblems")
</aside>