@page "/child-academic-problems/understanding-your-childs-reading-problems"
@model manaslearning.UI.Pages.ChildAcademicProblems.ReadingModel
@{
    Layout = "~/Pages/Shared/_LayoutForPages.cshtml";
    ViewBag.Title = "Understanding your child's trouble with reading";
    ViewBag.MetaDescription = "Children may struggle with reading within the classroom for various reasons, including limited experience with books, speech and hearing problems, and poor phonemic awareness. Learn what to look for and how you can help.";
    ViewBag.MetaKeywords = "common reading problems, limited experience with books, speech and hearing problems, poor phonemic awareness";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("10/12/2020", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}

<article>
    <!-- Banner innerpage -->
    <div class="innerpage-banner center bg-overlay-dark-7 reading-page-banner-background-image">
        <div class="container">
            <div class="row all-text-white">
                <div class="col-md-12 text-left">
                    <div class="hero-wrapper">
                        <div class="hero-container pt-4 pb-3">
                            <div class="hero-button">
                                <a class="btn btn-sm btn-white btn-round-home" href="/child-academic-problems"><i class="fa fa-angle-left"></i>Child Academic Problems</a>
                            </div>
                            <div class="hero-content">
                                <header>
                                    <h1 class="innerpage-title">Difficulties Learning to Read</h1>
                                </header>
                                @*<h6 class="subtitle">We transform your perception into an excellent website</h6>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container py-3 py-md-4">
        <div class="row">
            <div class="col-12">
                <div class="divider"></div>
            </div>
        </div>
    </div>
    <!-- Topic Description -->
    <section class="pt-0 pb-3 text-dark">
        <div class="container article">
            <div class="row">
                <!-- accordion gradient -->
                <div class="col-md-12">
                    <main>
                        <div>
                            <h2 class="text-primary display-8">Understanding Your Child's Trouble with Reading</h2>
                            <p class="fs-1">
                                Reading is the first thing we learn in the school; some children find it difficult or are not naturally good in reading. They are very good at oral but poor in writing and expression. The reading problems can be due to various reasons and affect their reading, writing, spelling and comprehension. The problem could be in all languages or just English.
                            </p>
                            <h2 class="text-primary display-8">Signs of Reading Problem</h2>
                            <ul class="mb-3" type="disc">
                                <li>Confusion between b and d, order of letters was - saw.</li>
                                <li>Can’t read words, guesses the words, can’t remember common words.</li>
                                <li>Difficulty in reading, reading aloud, makes sounds while reading like aaaa, uummm, leaves unknown and difficult words while reading, reads without expression and ignores punctuations.</li>
                                <li>Reading is so hard that it’s difficult to understand or comprehend what is read.</li>
                                <li>Reads very slowly and reading tires the child greatly.</li>
                            </ul>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </section>
</article>
<!-- Other topics -->
<aside>
    @await Component.InvokeAsync("ChildAcademicProblems")
</aside>