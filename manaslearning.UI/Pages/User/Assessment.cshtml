@page  "/u/assessments/{name}/{id}/{sid}/{lid}"

@model manaslearning.UI.Pages.User.AssessmentModel
@{
    ViewData["Title"] = @Model.Assessment.Name;
    Layout = "~/Pages/Shared/_LayoutForUser.cshtml";
}

<!-- Breadcrumb -->
@await Component.InvokeAsync(
    "Breadcrumb",
    @Model.BreadcrumbViewModel
)

<!-- Page content -->
<section class="assessment-section py-sm-5 pt-0 pb-3">
    @if (Model.HasLicense)
    {
        <form method="post">
            <div class="container assessment-container px-3 py-3">
                <div>
                    <h2>
                        @Model.Assessment.Name <i class="pull-right cursor-pointer" data-toggle="modal" data-target="#selectAssessmentLanguageModal" title="Change Assessment Language">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-translate" viewBox="0 0 16 16">
                                <path d="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286H4.545zm1.634-.736L5.5 3.956h-.049l-.679 2.022H6.18z"></path>
                                <path d="M0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2zm7.138 9.995c.193.301.402.583.63.846-.748.575-1.673 1.001-2.768 1.292.178.217.451.635.555.867 1.125-.359 2.08-.844 2.886-1.494.777.665 1.739 1.165 2.93 1.472.133-.254.414-.673.629-.89-1.125-.253-2.057-.694-2.82-1.284.681-.747 1.222-1.651 1.621-2.757H14V8h-3v1.047h.765c-.318.844-.74 1.546-1.272 2.13a6.066 6.066 0 0 1-.415-.492 1.988 1.988 0 0 1-.94.31z"></path>
                            </svg>
                        </i>
                    </h2>
                </div>
                <h6>Question @Model.Question?.Item2?.Sno of @Model.StudentAssessment?.NumberOfQuestions</h6>
                <div class="progress mt-1 mb-4" style="height: 2px;">
                    @{ var progressPercentageString = $"{Model.ProgressPercentage}%"; }
                    <div class="progress-bar bg-success" role="progressbar" style="width: @progressPercentageString;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                @if (Model.Question != null)
                {
                    <div class="assessment-question">
                        <div class="row">
                            <div class="col-sm-12 alert-container">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="max-width: 2.5rem !important;">
                                <span class="assessment-question-number font-weight-bold">@Model.Question.Item2?.Sno.</span>
                            </div>
                            <div class="col-10">
                                @if (Model.LanguageId != 5 && !string.IsNullOrWhiteSpace(Model?.Question?.Item2?.QuestionTranslation)) // Language specific question, 5: English
                                {
                                    <p class="mb-1 assessment-question-title">@Model.Question.Item2?.QuestionTranslation</p>
                                }
                                <p class="assessment-question-title">@Model.Question.Item2?.Question</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-2" style="max-width: 2.5rem !important;"></div>
                            <div class="col-10">
                                <input type="hidden" asp-for="PostModel.Param1" value="@Model.Assessment.GuidId" />
                                <input type="hidden" asp-for="PostModel.Param2" value="@Model.Question.Item2.StudentAssessmentId" />
                                <input type="hidden" asp-for="PostModel.Param3" value="@Model.Question.Item2.QuestionId" />
                                <input type="hidden" asp-for="PostModel.Param4" value="@Model.Question.Item2.GuidId" />
                                <input type="hidden" asp-for="PostModel.Param5" value="@Model.LanguageId" />
                                @if (Model.Question.Item3 != null)
                                {
                                    foreach (var item in Model.Question.Item3)
                                    {
                                        <div class="assessment-question-choice">
                                            <input id="quiz-choice-0-@item.Sno" type="radio" asp-for="PostModel.Param6" class="quiz-choice mt-3 mx-2" value="@item.GuidId" />
                                            <label for="quiz-choice-0-@item.Sno">
                                                @if (Model.LanguageId != 5 && !string.IsNullOrWhiteSpace(@item?.OptionTranslation)) // 5: English
                                                {
                                                    <p class="mb-1 assessment-question-title cursor-pointer">@item.OptionTranslation</p>
                                                }
                                                else
                                                {
                                                    <span class="cursor-pointer">@item.Option</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="container">
                <div class="row mt-4">
                    <div class="offset-md-5 col-md-2 offset-2 col-8 text-center">
                        <button class="btn btn-block btn-grad submit-assessment">Submit</button>
                    </div>
                </div>
            </div>
        </form>
        <div class="modal fade" id="selectAssessmentLanguageModal" tabindex="-1" aria-labelledby="selectAssessmentLanguageLable" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <h6 class="modal-title" id="selectAssessmentLanguageLable">Select Assessment Language</h6>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="list-group">
                            @if (Model.AssessmentLanguages != null)
                            {
                                @foreach (var language in Model.AssessmentLanguages)
                                {
                                    <a class="list-group-item list-group-item-action @((Model.LanguageId == language.LanguageId) ? "disabled" : "text-success")" href="/u/assessments/adhd/@Model.Assessment.GuidId/@Model.Student.StudentId/@language.LanguageId" style="display: block !important;">@language.LanguageName <i class="bi bi-chevron-right pull-right"></i></a>
                                }
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong> @Model.ErrorMessage </strong>
        </div>
    }

</section>