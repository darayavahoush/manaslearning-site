@page "/u/users"

@using manaslearning.Models;
@model manaslearning.UI.Pages.User.UsersModel
@{
    ViewData["Title"] = "Users";
    Layout = "~/Pages/Shared/_LayoutForUser.cshtml";
}

<!-- Breadcrumb -->
@await Component.InvokeAsync(
    "Breadcrumb",
    @Model.BreadcrumbViewModel
)

<!-- Page content -->
<section class="py-sm-5 pt-4">
    <div class="container">
        <div class="row">
            <div class="col-12 mb-1 order-md-2">
                <div class="card card-sm">
                    <div class="card-header card-header-table bg-light">
                        <div>
                            <button type="button" class="btn btn-primary btn-add-user float-right">Add User</button>
                        </div>
                    </div>
                    <div class="list-group list-group-flush">
                        <div class="table-responsive-sm">
                            <table class="table table-hover table-users align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">First Name</th>
                                        <th scope="col">Last Name</th>
                                        <th scope="col">Display Name</th>
                                        <th scope="col">Email</th>
                                        <th scope="col">Is Active</th>
                                        <th scope="col" class="text-center width-5">Edit</th>
                                        <th scope="col" class="text-center width-5">Reset</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="bg-white">
                                        <td colspan="7" class="text-center">
                                            <div class="my-3">
                                                <img class="img-add-user cursor-pointer" src="/user/icons/add.svg" width="32" height="32" />
                                            </div>
                                            <div class="text-center mb-2">
                                                Add users to start.
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <input id="hfRecordId" type="hidden" />
                        </div>
                    </div>
                </div>
            </div>
            <!--end of col-->
        </div>
        <!--end of row-->
    </div>
    <!--end of container-->
</section>
<!-- add user modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserModalLabel">Add User</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="form-user">
                    <!-- First Name -->
                    <div class="form-group row mb-0 mb-sm-3">
                        <div class="col-sm-3">
                            <label for="user-first-name" class="col-form-label float-left float-sm-right">First Name:</label>
                        </div>
                        <div class="col-sm-9">
                            <input type="text" class="form-control mb-0" maxlength="50" id="user-first-name">
                            <small>Max. 50 characters allowed.</small>
                        </div>
                    </div>
                    <!-- Last Name -->
                    <div class="form-group row mb-0 mb-sm-3">
                        <div class="col-sm-3">
                            <label for="user-last-name" class="col-form-label float-left float-sm-right">Last Name:</label>
                        </div>
                        <div class="col-sm-9">
                            <input type="text" class="form-control mb-0" maxlength="50" id="user-last-name">
                            <small>Max. 50 characters allowed.</small>
                        </div>
                    </div>
                    <!-- Display Name -->
                    <div class="form-group row mb-0 mb-sm-3">
                        <div class="col-sm-3">
                            <label for="user-display-name" class="col-form-label float-left float-sm-right">Display Name:</label>
                        </div>
                        <div class="col-sm-9">
                            <input type="text" class="form-control mb-0" maxlength="50" id="user-display-name">
                            <small>Max. 100 characters allowed.</small>
                        </div>
                    </div>
                    <!-- Email -->
                    <div class="form-group row mb-0">
                        <div class="col-sm-3">
                            <label for="user-email" class="col-form-label float-left float-sm-right">Email:</label>
                        </div>
                        <div class="col-sm-9">
                            <input type="email" class="form-control mb-0 mb-sm-3" maxlength="256" id="user-email">
                        </div>
                    </div>
                    <!-- Class -->
                    <div class="form-group row mb-0 mb-sm-3">
                        <div class="col-sm-3">
                            <label for="user-teacher-classes" class="col-form-label float-left float-sm-right">Select classes</label>
                        </div>
                        <div class="col-sm-9">
                            <select class="form-control" id="user-teacher-classes" multiple="multiple">
                                @if (Model.studentClasses != null)
                                {
                                    foreach (var item in Model.studentClasses)
                                    {
                                        <option value="@item.ClassId">@item.ClassName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <!-- IsActive -->
                        <div class="form-group row mb-0">
                            <div class="offset-sm-3 col-sm-9">
                                <div class="custom-control custom-checkbox mr-sm-2 mt-3">
                                    <input type="checkbox" class="custom-control-input" id="user-isactive" checked>
                                    <label class="custom-control-label" for="user-isactive">IsActive</label>
                                </div>
                            </div>
                        </div>
                        <!-- Verify Email -->
                        <div class="form-group row mb-0 row-verify-email">
                            <div class="offset-sm-3 col-sm-9">
                                <div class="custom-control custom-checkbox mr-sm-2 mt-3">
                                    <input type="checkbox" class="custom-control-input" id="user-verify-email">
                                    <label class="custom-control-label" for="user-verify-email">Do you want verify email?</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="row mb-0 mb-sm-3 d-none" id="divErrorMessagesRow">
                    <div class="col-sm-3">
                    </div>
                    <div class="col-sm-9">
                        <div id="divErrorMessage" class="alert alert-danger"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-save-user">Save</button>
            </div>
        </div>
    </div>
</div>
<!-- add user reset password modal -->
<div class="modal fade" id="addUserResetModal" tabindex="-1" aria-labelledby="addUserResetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addUserResetModalLabel">Reset Password</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form class="form-user">
                    Do you want to reset the password for this email?
                </form>
                <div class="row mb-0 mb-sm-3 d-none" id="divResetPasswordErrorMessagesRow">
                    <div class="col-sm-3">
                    </div>
                    <div class="col-sm-9">
                        <div id="divResetPasswordErrorMessage" class="alert alert-danger"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-reset-user-password">Reset Password</button>
            </div>
        </div>
        <input id="hfEmailId" type="hidden" />
    </div>
</div>
