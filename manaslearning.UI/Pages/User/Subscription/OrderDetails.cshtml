@page "/u/bill-overview/{orderOid}"
@model manaslearning.UI.Pages.User.Subscription.OrderDetailsModel
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Pages/Shared/_LayoutForUser.cshtml";
}
<!-- Breadcrumb-->
@await Component.InvokeAsync("Breadcrumb", Model.BreadcrumbViewModel)
<section class="py-3 py-sm-3 pb-1">
    <div class="container">

        <div class="row">
            <div class="col-sm-12">
                <h2>Order: #@Model.Order.OrderNumber</h2>
            </div>
        </div>
        <div class="border"></div>
        <div class="row">
            <div class="col-12 col-md-3 mt-2">
                <div class="d-address p-3 p-md-0">
                    <h5 class="pt-3 mb-3">Sold To</h5>
                    <ul class="list-unstyled">
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingName))
                        {
                            <li>@Model.Order.BillingName</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingAddressLine1))
                        {
                            <li>@Model.Order.BillingAddressLine1</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingAddressLine2))
                        {
                            <li>@Model.Order.BillingAddressLine2</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingAddressLine3))
                        {
                            <li>@Model.Order.BillingAddressLine3</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingCity))
                        {
                            <li>@Model.Order.BillingCity</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingState) || !string.IsNullOrWhiteSpace(Model.Order.BillingZipCode))
                        {
                            <li>@($"{@Model.Order.BillingState}, {@Model.Order.BillingZipCode}")</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Order.BillingCountry))
                        {
                            <li>@Model.Order.BillingCountry</li>

                        }
                    </ul>
                </div>
            </div>
            <div class="col-12 col-md-9 mt-2">
                <div class=" d-none d-md-block">
                    <table class="table table-hover table-subscriptions align-items-center mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="border-0">Purchased Date</th>
                                <th scope="col" class="border-0">Product Name</th>
                                <th scope="col" class="border-0 text-right">Price</th>
                                <th scope="col" class="border-0 text-right">Quantity</th>
                                <th scope="col" class="border-0 text-right">Subtotal</th>
                                <th scope="col" class="border-0 text-right">Tax</th>
                                <th scope="col" class="border-0 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bg-white">
                                <td>
                                    @Model.Order.PurchasedDate
                                    <br /><small>@Model.Order.PurchasedTime</small>
                                </td>
                                <td>@Model.Order.ProductName</td>
                                <td class="text-right">@Model.Order.CurrencySymbol@Model.Order.ItemPrice.ToString("F2")</td>
                                <td class="text-right">@Model.Order.Quantity</td>
                                <td class="text-right">@Model.Order.CurrencySymbol@Model.Order.Subtotal.ToString("F2")</td>
                                <td class="text-right">@Model.Order.CurrencySymbol@Model.Order.GSTAmount.ToString("F2")</td>
                                <td class="text-right">@Model.Order.CurrencySymbol@Model.Order.TotalAmount.ToString("F2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="feature-box f-style-4 bg-light p-3 d-md-none">
                    <div class="clearfix">
                        <span class="float-left">Purchase Date:</span>
                        <span class="float-right">@Model.Order.PurchasedDate<br /><small class="float-right">@Model.Order.PurchasedTime</small></span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left">Name:</span>
                        <span class="float-right">@Model.Order.ProductName</span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left">Price:</span>
                        <span class="float-right">@Model.Order.CurrencySymbol@Model.Order.ItemPrice.ToString("F2")</span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left">Quantity:</span>
                        <span class="float-right">@Model.Order.Quantity</span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left">Subtotal:</span>
                        <span class="float-right">@Model.Order.CurrencySymbol@Model.Order.ItemPrice.ToString("F2")</span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left">Tax: <i class="bi bi-info-circle-fill text-black-50" data-toggle="tooltip" data-placement="top" title="@(Model.Order.GSTRate.ToString("F2"))% GST"></i></span>
                        <span class="float-right">@Model.Order.CurrencySymbol@Model.Order.GSTAmount.ToString("F2")</span>
                    </div>
                    <div class="clearfix">
                        <span class="float-left font-weight-bold">Total:</span>
                        <span class="float-right font-weight-bold it-io-to">@Model.Order.CurrencySymbol@Model.Order.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>
        </div>
        <!--End of row-->
    </div>
    <!-- End of Container-->
</section>