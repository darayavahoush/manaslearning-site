@page "/u/catalog/{itemOid}"
@model manaslearning.UI.Pages.User.Subscription.ManageSubscriptionModel
@{
    ViewData["Title"] = "Subscriptions"; // TODO: Update this title
    Layout = "~/Pages/Shared/_LayoutForUser.cshtml";
}

<!-- Breadcrumb -->
@await Component.InvokeAsync(
    "Breadcrumb",
    @Model.BreadcrumbViewModel
)

<section class="py-3 py-sm-3 pb-1">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <h2>ADHD Assessment</h2>
            </div>
            <div class="col-md-6 mt-2">
                <div class="feature-box f-style-4 h-100">
                    <div class="divider"></div>
                    <h5 class="pt-3 mb-3">License</h5>
                    <div class="skill-item mb-2">
                        <h4>10/15 assigned</h4>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar border-radius-0" role="progressbar" style="width: 66%;" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-square-fill text-primary mr-2" viewBox="0 0 16 16">
                                <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2z" />
                            </svg>
                        </span>
                        <span> Assigned </span>
                        <span class="ml-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#f0f1f3" class="bi bi-square-fill mr-2" viewBox="0 0 16 16">
                                <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2z" />
                            </svg>
                        </span>
                        <span> Available </span>
                    </div>
                    <div>
                        <button class="btn btn-primary btn-sm px-4"> Buy licenses </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-2">
                <div class="feature-box f-style-4 h-100">
                    <div class="divider"></div>
                    <h5 class="pt-3 pb-2">Purchase Infrormation</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Initial purchase date</h6>
                            <p>04/17/2021</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Unit price</h6>
                            <p>₹199.00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--end of row-->
    </div>
    <!--end of container-->
</section>