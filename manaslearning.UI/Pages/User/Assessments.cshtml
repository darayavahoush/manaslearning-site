@page "/u/assessments"

@using manaslearning.Models;
@model manaslearning.UI.Pages.User.AssessmentsModel
@{
    ViewData["Title"] = "Assessments";
    Layout = "~/Pages/Shared/_LayoutForUser.cshtml";
}

<!-- Breadcrumb -->
@await Component.InvokeAsync(
    "Breadcrumb",
    @Model.BreadcrumbViewModel
)

<!-- Page content -->
<section class="py-sm-5 pt-4 section-user-assessments">
    <div class="container">
        @*<div class="row">
            <div class="col-sm-12">
                <h2>Assessments</h2>
            </div>
        </div>*@
        <div class="row pt-0">
            @if (Model.Assessments != null)
            {
                foreach (var assessment in Model.Assessments)
                {
                    <div class="col-md-4 mt-4">
                        <div class="feature-box card f-style-1 h-100">
                            <div class="feature-box-icon pt-2 pt-sm-0">
                                <img class="w-100" src="~/images/@assessment.ImageName" alt="@assessment.Name" />
                            </div>
                            <h3 class="feature-box-title">@assessment.Name</h3>
                            <p class="feature-box-desc mb-3">@assessment.Description</p>
                            <div class="mt-auto">
                                <button type="button" class="btn btn-sm btn-link btn-light" data-toggle="modal" data-target="#modal-@assessment.Code.ToLower()"> Read More</button>
                                <!-- Modal -->
                                <div class="modal fade" id="modal-@assessment.Code.ToLower()" tabindex="-1" aria-labelledby="ADHD" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">@assessment.Name</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">×</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <p>@assessment.Description</p>
                                                @if (assessment.Symptoms != null && assessment.Symptoms.Any())
                                                {
                                                    <h5>Symptoms:</h5>
                                                    <ul class="list-group list-group-borderless list-group-icon-primary-bg pt-2 pb-3">
                                                        @foreach (var symptom in assessment.Symptoms)
                                                        {
                                                            <li class="list-group-item"><i class="fa fa-check"></i> @symptom</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                @if (!assessment.HasLicense)
                                {
                                    <a class="btn btn-primary btn-sm float-right" href="/u/catalog/n/@assessment.ItemOid"> Buy Licenses </a>
                                }
                                else
                                {
                                    <a class="btn btn-primary btn-sm float-right" href="@UrlConstants.USER_ASSESSMENTS/@assessment.MetaUrl/@assessment.GuidId.ToString()/info"> Start Assessment </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
<!--end of section-->