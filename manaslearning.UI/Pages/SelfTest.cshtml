@page "/self-test/{testName}/{testId:int}"
@model manaslearning.UI.Pages.SelfTestModel
@{
    Layout = "~/Pages/Shared/_LayoutForAssessmentPages.cshtml";
    ViewBag.Title = $"Free Assessment - {@Model.freeAssessment.AssessmentTitle}";
    ViewBag.MetaDescription = $"Free Self Assessment - {@Model.freeAssessment.AssessmentTitle}: {@Model.freeAssessment.AssessmentDescription}";
    ViewBag.BaseAddress = Request.Path == "/" ? Request.GetDisplayUrl() : $"{Request.GetDisplayUrl().Replace(Request.Path, "")}";
    ViewBag.Url = Url.PageLink();
    ViewBag.ModifiedDate = (DateTime.ParseExact("09/26/2020", "MM/dd/yyyy", System.Globalization.CultureInfo.InvariantCulture).ToString());
}

<section class="assessment-section pt-md-4 pt-3 pb-2">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/assessments">Assessments</a></li>
                <li class="breadcrumb-item"><a href="/free-assessments">Free Self Tests</a></li>
            </ol>
        </nav>
    </div>
</section>
<section class="assessment-section pt-md-0 pt-0 pb-md-3 pb-3">
    <div class="container assessment-container" data-lower-limit="@Model.freeAssessment.LowerLimit" data-upper-limit="@Model.freeAssessment.UpperLimit">
        <h2 class="pb-md-4 pb-3">@Model.freeAssessment.AssessmentTitle</h2>
        <div class="divider mt-1 mb-4"></div>
        <input id="hfDefaultMessage" type="hidden" value="@Model.freeAssessment.DefaultMessage" />
        <input id="hfLowerLimitMessage" type="hidden" value="@Model.freeAssessment.LowerLimitMessage" />
        <input id="hfUpperLimitMessage" type="hidden" value="@Model.freeAssessment.UpperLimitMessage" />
        @foreach (var item in Model.freeAssessmentQuestions)
        {
            <div class="row mb-3">
                <div class="col-12 assessment-question">
                    <div class="assessment-question-title mb-3">
                        <span class="mr-2 font-weight-bold">@item.Id.</span><p>@item.Question</p>
                    </div>
                    <div class="assessment-question-choice mx-3 mt-1">
                        <input id="quiz-choice-@item.Id-0" type="radio" name="@item.Id" value="0" class="quiz-choice quiz-choice-yes mt-3 mx-2" />
                        <label for="quiz-choice-@item.Id-0">
                            <span>Yes</span>
                        </label>
                    </div>
                    <div class="assessment-question-choice mx-3 mt-1">
                        <input id="quiz-choice-@item.Id-1" type="radio" name="@item.Id" value="1" class="quiz-choice quiz-choice-no mt-3 mx-2" />
                        <label for="quiz-choice-@item.Id-1">
                            <span>No</span>
                        </label>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="container">
        <div class="row mt-4">
            <div class="offset-md-5 col-md-2 offset-2 col-8 text-center">
                <button class="btn btn-block btn-grad submit-test">Submit</button>
            </div>
        </div>
    </div>
</section>
<!-- warning modal -->
<div class="modal fade" id="warningModal" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="warningModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="text-center">
                    <h1 class="mt-3 warning-modal-icon"><i class="ti-alert"></i></h1>
                    <h4 class="mt-2 warning-modal-title">Something missing!!!</h4>
                    <p class="my-3 warning-modal-content text-dark">Please select options for all the questions.</p>
                    <button type="button" class="btn btn-warning-continue my-2" data-dismiss="modal">Continue</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- success modal -->
<div class="modal fade" id="successModal" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="successModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="text-center">
                    <h1 class="mt-3 success-modal-icon"><i class="ti ti-face-smile"></i></h1>
                    <h4 class="mt-2 success-modal-title">Hurray!!!</h4>
                    <p class="my-3 success-modal-content text-dark">Your child does not have any problem.</p>
                    <button type="button" class="btn btn-success-continue my-2" data-dismiss="modal">Close</button>
                </div>
            </div>
            @*<div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Need Help?</button>
                </div>*@
        </div>
    </div>
</div>