@page "/account/forgot-password-confirmation"
@model ForgotPasswordConfirmation
@{
    Layout = "_LayoutForLoginLogout";
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    body {
        background: rgb(151,199,78);
        background: linear-gradient(90deg, rgba(151,199,78,0.83) 0%, rgba(42,185,165,0.83) 50%), url("/images/login-bg.jpg") no-repeat top center;
    }
</style>
<section class="p-0 d-flex align-items-center">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-5 mx-auto my-5">
                <div class="row h-100 m-1">
                    <div class="col-12 col-md-10 col-lg-9 col-xl-8 text-left mx-auto d-flex align-items-center bg-white p-3 border-radius-3">
                        <div class="w-100">
                            <div class="text-center mb-3">
                                <img src="~/images/logo/favicon/mstile-150x150.png" width="48" height="48" alt="MANAS Learning" />
                            </div>
                            <h5 class="text-center mb-0">@ViewData["Title"]</h5>
                            <hr />
                            <p>Please check your email to reset your password.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>