@page "/account/forgot-password"
@model ForgotPasswordModel
@{
    Layout = "_LayoutForLoginLogout";
    ViewData["Title"] = "Forgot your password?";
}

<style>
    body {
        background: rgb(151,199,78);
        background: linear-gradient(90deg, rgba(151,199,78,0.83) 0%, rgba(42,185,165,0.83) 50%), url("/images/login-bg.jpg") no-repeat top center;
    }
</style>
<section class="p-0 d-flex align-items-center">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-5 mx-auto my-5">
                <div class="row h-100 m-1">
                    <div class="col-12 col-md-10 col-lg-9 col-xl-8 text-left mx-auto d-flex align-items-center bg-white p-3 border-radius-3">
                        <div class="w-100">
                            <div class="text-center mb-3">
                                <a href="/">
                                    <img src="~/images/logo/favicon/mstile-150x150.png" width="48" height="48" alt="MANAS Learning" />
                                </a>
                            </div>
                            <h5 class="text-center mb-0">@ViewData["Title"]</h5>
                            <hr />
                            <form method="post">
                                <div class="form-group">
                                    <label asp-for="Input.Email"></label>
                                    <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" />
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
