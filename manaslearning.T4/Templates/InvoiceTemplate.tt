<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>Invoice - MANAS Learning</title>
    <style>
        @import url(https://fonts.googleapis.com/css?family=Roboto:100,300,400,900,700,500,300,100);

        body {
            padding: 0;
            margin: 0;
            background-color: #eeeeee;
            font-family: 'Roboto', sans-serif;
        }

        a {
            text-decoration: underline;
            color: #00a63f;
        }

        .invocienumber {
            text-align: right
        }

        .invoice_text {
            font-size: 1.5em;
            color: #444;
            font-weight: bold
        }

        .invoice_num {
            font-size: 1.5em;
            color: #444;
            font-weight: bold
        }

        .invoice_datetext {
            font-size: 0.8em;
            color: #666;
            line-height: 1.4em;
        }

        .message {
            font-size: 0.9em;
            color: #555;
            line-height: 1.4em;
        }

        .clientinfo {
            display: inline-block;
            vertical-align: middle;
        }

        .supplier {
            margin-bottom: 12px;
            color: #444;
            font-size: 1.05em;
            font-weight: bold
        }

        .address {
            margin-bottom: 5px;
            color: #555;
            font-size: 0.85em;
        }

        .gst {
            text-align: right;
            margin-bottom: 5px;
            color: #555;
            font-size: 0.85em;
            line-height: 1.8em;
            padding: 15px 0;
        }

        table {
            border-collapse: collapse;
        }

        .list-item {
            border-bottom: 1px solid #cccaca;
            font-size: 0.80em;
        }

        .tabletitle th {
            font-size: 0.8em;
            padding: 5px 0px;
            border-bottom: 2px solid #ddd;
        }

            .tabletitle th:nth-child(1) {
                text-align: left;
            }

            .tabletitle th:nth-child(2) {
                text-align: center;
            }

            .tabletitle th:nth-child(3) {
                text-align: center;
            }

            .tabletitle th:nth-child(4) {
                text-align: center;
            }

            .tabletitle th:nth-child(5) {
                text-align: center;
            }

            .tabletitle th:nth-child(6) {
                text-align: right;
            }

        .item {
            width: 50%;
        }

        .total-row th, .total-row td {
            font-weight: 700;
            font-size: .90em;
            border: 0 none;
        }

        .table-main {
            width: 100%
        }

        .total-row {
            font-size: 1.05em;
            color: #000;
            line-height: 1.9em;
        }

        @media screen and (max-width:700px) {

            table[class=innercontent], tr[class=innercontent], td[class=innercontent], img[class=innercontent] {
                width: 100% !important;
                height: auto;
            }

            .invocienumber {
                text-align: left;
                padding: 12px 0
            }

            .invoice_text {
                font-size: 1.1em;
                color: #444;
                font-weight: bold
            }

            .invoice_num {
                font-size: 1.1em;
                color: #444;
                font-weight: bold
            }

            .invoice_datetext {
                font-size: 0.8em;
                color: #666;
                line-height: 1.4em;
            }

            .gst {
                text-align: left;
                margin-bottom: 5px;
                color: #555;
                font-size: 0.85em;
            }
            /* Table */
            .table-main {
                border: 0 none;
            }

                .table-main thead {
                    border: none;
                    clip: rect(0 0 0 0);
                    height: 1px;
                    margin: -1px;
                    overflow: hidden;
                    padding: 0;
                    position: absolute;
                    width: 1px;
                }

                .table-main tr {
                    border-bottom: 2px solid #eee;
                    display: block;
                    margin-bottom: 20px;
                }

                .table-main td {
                    font-weight: 700;
                    display: block;
                    max-width: none;
                    position: relative;
                    padding-right: 5px;
                    border: 1px solid #cccaca;
                    text-align: right;
                }

                    .table-main td:before {
                        /* aria-label has no advantage, it won't be read inside a table content: attr(aria-label); */
                        content: attr(data-label);
                        position: absolute;
                        left: 10px;
                        font-weight: normal;
                        text-transform: uppercase;
                    }

            [data-label]::before {
                /* aria-label has no advantage, it won't be read inside a table content: attr(aria-label); */
                content: attr(data-label);
                position: absolute;
                left: 10px;
                font-weight: normal;
                text-transform: uppercase;
            }

            <![endif] -->
            thead {
                display: none;
            }

            .total-row th {
                display: none;
            }

            .total-row td {
                text-align: right;
            }

            .list-item td {
                text-align: right;
            }

            #table {
                white-space: nowrap;
                overflow: auto;
            }

            .tabletitle th:nth-child(2) {
                text-align: center;
            }

            .tabletitle th:nth-child(3) {
                text-align: center;
            }

            .tabletitle th:nth-child(4) {
                text-align: center;
            }

            .tabletitle th:nth-child(5) {
                text-align: center;
            }

            .tabletitle th:nth-child(6) {
                text-align: right;
            }
        }
    </style>
</head>
<body>
    <!-- start main table -->
    <table width="700" align="center" border="0" cellspacing="0" cellpadding="0" class="innercontent">
        <tbody>
            <!-- start logo -->
            <tr>
                <td style="padding: 15px 20px; background-color: #fff; border-bottom: 2px solid #00a63f;">
                    <table width="45%" align="left" border="0" cellspacing="0" cellpadding="0" class="innercontent">
                        <tbody>
                            <tr>
                                <td> <img style="width:200px" src="https://i.ibb.co/mq265Pq/manasl.png"></td>
                            </tr>

                        </tbody>
                    </table>
                    <table width="45%" align="right" border="0" cellspacing="0" cellpadding="0" class="innercontent">
                        <tbody>
                            <tr>
                                <td class="invocienumber">
                                    <span class="invoice_text">Invoice</span> #<span class="invoice_num"><#= invoice?.InvoiceNumber #></span><br>
                                    <span class="invoice_datetext">Invoice Date: <span class="invoice_date"><#= invoice?.InvoiceDate #></span></span>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </td>
            </tr>
            <!-- end logo -->           
            <!-- title and description -->
            <tr>
                <td style="padding: 15px 20px; background-color: #fff; ">
                    <table width="45%" align="left" border="0" cellspacing="0" cellpadding="0" class="innercontent">
                        <tbody>
                            <tr>
                                <td class="clientinfo">
                                    <span class="supplier">Sold To</span><br>
                                    <span class="address">
                                        <#= invoice?.Customer?.Name #>
                                        <br />
                                        <#= invoice?.Customer?.CustomerAddress?.Address1 #>
                                        <#if(!string.IsNullOrEmpty(invoice?.Customer?.CustomerAddress?.Address2)) { #>
                                        <br />
                                        <#= invoice?.Customer?.CustomerAddress?.Address2 ?? string.Empty #>
                                        <# } #>
                                        <#if(!string.IsNullOrEmpty(invoice?.Customer?.CustomerAddress?.Address3)) { #>
                                        <br />
                                        <#= invoice?.Customer?.CustomerAddress?.Address3 ?? string.Empty #>
                                        <# } #>
                                        <br />
                                        <span id="city"><#= invoice?.Customer?.CustomerAddress?.City #></span> - <span id="zip"><#= invoice?.Customer?.CustomerAddress?.ZipCode #></span>
                                        <br />
                                        <span id="country"><#= invoice?.Customer?.CustomerAddress?.State #></span>
                                        <br />
                                        <span id="country"><#= invoice?.Customer?.CustomerAddress?.Country #></span>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table width="45%" align="right" border="0" cellspacing="0" cellpadding="0" class="innercontent">
                        <tbody>
                            <tr>
                                <td class="gst">
                                    <span><strong>GST No:</strong></span><label id="GST"> <#= invoice?.Company?.GSTIN ?? string.Empty #></label>                                    
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </td>
            </tr>
            <tr>
                <td style="background-color: #ffffff; padding: 10px 20px 35px 20px; font-family:sans-serif; font-size: 15px; line-height: 22px;">
                    <div id="invoice-bot">
                        <div id="table">
                            <table class="table-main">
                                <thead>
                                    <tr class="tabletitle">
                                        <th align="left">Product Name</th>
                                        <th align="center">Quantity</th>
                                        <th align="center">Unit Price</th>
                                        <th align="center">Tax %</th>
                                        <th align="center">Tax Amount</th>
                                        <th align="right">
                                            Total Amount
                                        </th>
                                    </tr>
                                </thead>
                                <# foreach(var invoiceItem in invoice?.InvoiceItems){ #>
                                <tr class="list-item">
                                    <td data-label="Product Name" class="tableitem"><#= invoiceItem?.ProductName ?? string.Empty #></td>
                                    <td align="center" class="tableitem" data-label="Quantity"><#= invoiceItem?.Quantity #></td>
                                    <td align="center" class="tableitem" data-label="Unit Price"><#= invoiceItem?.CurrencySymbol #><#= invoiceItem.Price.ToString("F2") #></td>
                                    <td align="center" class="tableitem" data-label="Tax %"><#= invoiceItem.GSTRate.ToString("F2") #></td>
                                    <td align="center" class="tableitem" data-label="Tax Amount"><#= invoiceItem?.CurrencySymbol #><#= invoiceItem.GSTAmount.ToString("F2") #></td>
                                    <td align="right" class="tableitem" data-label="Total Amount"><#= invoiceItem?.CurrencySymbol #><#= invoiceItem.TotalAmount.ToString("F2") #></td>
                                </tr>
                                <# } #>
                                <tr class="list-item total-row">
                                    <th align="left" colspan="5" class="tableitem">Grand Total</th>
                                    <td align="right" class="tableitem" data-label="Grand Total"><#= invoice?.InvoiceItems.Sum(i=>i.TotalAmount).ToString("F2") #></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </td>
            </tr>
            <!-- end title and description -->
            <!-- start colums -->
            <# if(invoice.IsEmail) { #>
            <tr>
                <td style="background-color: #ffffff; padding: 10px 20px 35px 20px; font-family: sans-serif; font-size: 13px; line-height: 22px;">
                    <p>
                        If you have any questions about this receipt, simply reply to this email or reach out to our <a href="mailto:support@manaslearning.com">support team</a> for help.
                    </p>
                    <br />
                    <p>
                        <strong>Thank You</strong>,<br>
                        MANAS Learning Team
                    </p>
                </td>
            </tr>
            <# } #>
            <!-- end colums -->
            <tr>
                <td style="font-family:sans-serif; font-size: 11px; line-height: 18px; padding: 30px; color: #777; background-color: #f5f5f5; text-align: center">
                    <p> © <#= DateTime.Now.Year #> <a href="https://manaslearning.com/">MANAS Learning</a>. All rights reserved.</p>
                    <p> Operated By: <strong><#= invoice?.Company.CompanyName #></strong></p>
                    <p> <#= invoice?.Company?.CompanyAddress?.Address1 #>, <#= invoice?.Company?.CompanyAddress?.Address2 #>, <#= invoice?.Company?.CompanyAddress?.Address3 #>, <#= invoice?.Company?.CompanyAddress?.City #>, <#= invoice?.Company?.CompanyAddress?.State #>, <#= invoice?.Company?.CompanyAddress?.Country #> - <#= invoice?.Company?.CompanyAddress?.ZipCode #>.</p>
                    <p>
                        Support:
                        <span class="email"><a href="mailto:<#= invoice?.Company.SupportEmail #>"><#= invoice?.Company.SupportEmail #></a> | <#= invoice?.Company.ContactNo #></span>
                    </p>
                </td>
            </tr>
        </tbody>
    </table>
    <!-- start main table -->
</body>
</html>
